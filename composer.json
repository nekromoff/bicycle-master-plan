{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "cyklokoalicia/bicycle-master-plan",
    "type": "project",
    "description": "Bicycle Master Plan interactive map.",
    "keywords": ["laravel", "framework", "cycling", "map"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "google/apiclient": "^2.19",
        "kris/laravel-form-builder": "^1.55",
        "laravel/framework": "^13.17",
        "laravel/socialite": "^5.30",
        "revolution/laravel-google-sheets": "^7.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "files": ["app/Helpers/Helper.php"],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": ["@php artisan key:generate --ansi"]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
